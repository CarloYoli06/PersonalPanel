{
  "name": "@panel/hub",
  "productName": "Panel Personal Hub",
  "version": "2.0.0",
  "description": "Hub modular ultraligero de escritorio en Tauri v2 (FileDiet + Escaner Albedo + PC Optimizer + PDF Studio)",
  "author": "Albedo",
  "scripts": {
    "dev:vite": "vite --config vite.config.ts",
    "build:vite": "vite build --config vite.config.ts",
    "preview:vite": "vite preview --config vite.config.ts",
    "tauri": "node ../../scripts/run-tauri.cjs",
    "tauri:dev": "node ../../scripts/run-tauri.cjs dev",
    "tauri:build": "npm run typecheck && node ../../scripts/run-tauri.cjs build",
    "dev": "npm run tauri:dev",
    "build": "npm run tauri:build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run tauri:build"
  },
  "dependencies": {
    "@panel/core-sdk": "*",
    "@panel/ui-kit": "*",
    "@panel/mod-video": "*",
    "@panel/mod-scanner": "*",
    "@panel/mod-optimizer": "*",
    "@panel/mod-pdf": "*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0"
  }
}
