{
  "name": "panel-personal-monorepo",
  "productName": "Panel Personal Hub",
  "private": true,
  "version": "2.0.0",
  "description": "Ecosistema de escritorio modular en Tauri v2 + Rust Cargo Workspaces",
  "author": "Albedo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "dev": "npm --workspace @panel/hub run dev",
    "build": "npm --workspace @panel/hub run build",
    "tauri": "npm --workspace @panel/hub run tauri",
    "tauri:dev": "npm --workspace @panel/hub run tauri:dev",
    "tauri:build": "npm --workspace @panel/hub run tauri:build",
    "typecheck": "npm --workspace @panel/hub run typecheck",
    "dist": "npm --workspace @panel/hub run dist"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@tauri-apps/api": "^2.2.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "lucide-react": "0.460.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
